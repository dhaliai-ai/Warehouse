<mxfile host="app.diagrams.net" modified="2026-11-24T20:00:00.000Z" agent="wms-c4" version="22.1.0" type="device">
  <diagram name="Components" id="Components">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Warehouse Backend API — C4 Level 3: Components (Proposed design)" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#0b2e4f;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="Logical components inside the Backend API container. Not separately deployed. Features 1–19 grouped. All depend on Security and Data access." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1300" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sec" value="&lt;b&gt;Security and warehouse access&lt;/b&gt;&lt;div&gt;[Component]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Auth, RBAC (ADR-0004), warehouse assignment (ADR-0008).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="co" value="&lt;b&gt;Company and warehouse administration&lt;/b&gt;&lt;div&gt;[Component Features 1–2]&lt;/div&gt;&lt;div style="font-size:11px"&gt;One company, multiple warehouses (ADR-0007).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="inv" value="&lt;b&gt;Item and inventory&lt;/b&gt;&lt;div&gt;[Component Features 3–4]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Item master, Individual and Case UPC, warehouse-specific bins.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="party" value="&lt;b&gt;Supplier and customer master&lt;/b&gt;&lt;div&gt;[Component Features 5–6]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Supplier and customer records. Drivers do not maintain master data.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="forms" value="&lt;b&gt;Order form management&lt;/b&gt;&lt;div&gt;[Component Features 7–8]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Reusable forms. Not actual submitted orders.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="so" value="&lt;b&gt;Supplier orders&lt;/b&gt;&lt;div&gt;[Component Feature 9]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Create and submit supplier orders. Quantity Ordered preserved.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rcv" value="&lt;b&gt;Receiving&lt;/b&gt;&lt;div&gt;[Component Feature 10]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Quantity Received only. Does not increase stored inventory.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="put" value="&lt;b&gt;Putaway&lt;/b&gt;&lt;div&gt;[Component Feature 11]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Confirmed putaway increases stored inventory.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="co2" value="&lt;b&gt;Customer orders&lt;/b&gt;&lt;div&gt;[Component Feature 12]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Actual customer orders. Does not deduct stored inventory.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pick" value="&lt;b&gt;Picking&lt;/b&gt;&lt;div&gt;[Component Feature 13]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Confirmed pick decreases stored inventory once.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="shp" value="&lt;b&gt;Shipping&lt;/b&gt;&lt;div&gt;[Component Feature 14]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Quantity Shipped. Does not deduct stored inventory again.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="del" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;div&gt;[Component Feature 15]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Quantity Delivered. Does not deduct stored inventory again.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="400" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rep" value="&lt;b&gt;Exception and monthly reporting&lt;/b&gt;&lt;div&gt;[Component Features 16–19]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Read-only: stockouts, supplier differences, delivery differences, monthly Quantity Shipped.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="da" value="&lt;b&gt;Data access and transactions&lt;/b&gt;&lt;div&gt;[Component Sequelize / MySQL InnoDB]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Atomic inventory updates. Duplicate confirmation rejected. Failed work is not committed as success.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#0b2e4f;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="550" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Increases stored inventory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="put" target="inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Decreases stored inventory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="pick" target="inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Persists Quantity Received" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="rcv" target="da">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Persists Quantity Shipped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="shp" target="da">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Persists Quantity Delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="del" target="da">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Reads operational records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="rep" target="da">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg" value="Receiving does not increase stored bins. Shipping and delivery do not deduct inventory after picking. Proposed logical design inside one Backend API container." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1300" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
