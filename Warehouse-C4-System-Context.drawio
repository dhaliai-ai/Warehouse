<mxfile host="app.diagrams.net" modified="2026-11-24T20:00:00.000Z" agent="wms-c4" version="22.1.0" type="device">
  <diagram name="System Context" id="SystemContext">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Warehouse Management System — C4 Level 1: System Context (Proposed design)" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#0b2e4f;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="Internal employees only. No supplier portal, customer portal, payment service, or carrier integration. Not implemented infrastructure." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mgr" value="&lt;b&gt;Managers and administrators&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Warehouse Manager and Administrator. Maintain company and warehouses, approve exceptions, review reports.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="off" value="&lt;b&gt;Office personnel&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Office clerks. Maintain master records, order forms, supplier orders, and customer orders.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="wms" value="&lt;b&gt;Warehouse Management System&lt;/b&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Paperless operations for one company with multiple warehouses: inventory, receiving, putaway, picking, shipping, delivery, and reporting.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="wh" value="&lt;b&gt;Warehouse floor personnel&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Warehouse workers. Receive, put away, pick, and authorized inventory movements. Handheld browser.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ship" value="&lt;b&gt;Shipping clerks&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Verify picked orders and record shipments. Does not deduct stored inventory again after picking.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="&lt;b&gt;Delivery drivers&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Assigned deliveries only. Record outcomes and discrepancies. Cannot edit master data.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="500" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Administers operations and reviews reports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="mgr" target="wms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Enters and maintains business records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="off" target="wms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Receives, puts away, picks, moves inventory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="wh" target="wms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Ships picked customer orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="ship" target="wms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Records assigned delivery results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="drv" target="wms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg" value="C4 Person and Software System. Proposed. ADR-0001, ADR-0004, ADR-0006. No external software systems are documented." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1200" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
