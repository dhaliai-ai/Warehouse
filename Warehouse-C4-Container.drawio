<mxfile host="app.diagrams.net" modified="2026-11-24T20:00:00.000Z" agent="wms-c4" version="22.1.0" type="device">
  <diagram name="Containers" id="Containers">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Warehouse Management System — C4 Level 2: Containers (Proposed design)" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#0b2e4f;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="ADR-0001 three-tier. ADR-0002 REST HTTPS JSON /api. ADR-0003 MySQL InnoDB via Sequelize. Frontend never connects to the database." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="desk" value="&lt;b&gt;Desktop users&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Managers, administrators, and office personnel using a desktop browser.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hand" value="&lt;b&gt;Handheld users&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Warehouse workers, shipping clerks, and drivers. Same web application. Camera barcode scanning (ADR-0005).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Warehouse Web Application&lt;/b&gt;&lt;div&gt;[Container: Vue 3, Vuetify, Vite, Vue Router, Axios]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Desktop and handheld UI. Axios JSON to backend. Does not access MySQL.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Warehouse Backend API&lt;/b&gt;&lt;div&gt;[Container: Node.js, Express, Sequelize]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Auth, RBAC, warehouse isolation, validation, inventory transactions. Only container that reads and writes the database.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Warehouse Database&lt;/b&gt;&lt;div&gt;[Container: MySQL, InnoDB]&lt;/div&gt;&lt;div style="font-size:11px"&gt;Relational data, constraints, atomic transactions. One company, many warehouses.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#0D5091;align=center;arcSize=8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="570" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Uses HTTPS browser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="desk" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Uses HTTPS browser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="hand" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="HTTPS REST JSON /api Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Sequelize SQL InnoDB transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg" value="System boundary is the three containers. No extra microservices, brokers, or databases. Proposed, not running infrastructure." style="text;html=1;fontSize=11;align=left;fontColor=#4b5a6b;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1200" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
